;  Generate with: openssl genrsa 2048 > dkim-private.pem
privateKey		= ""
;  DKIM domain (e.g., "example.com")
domain			= ""
;  DNS selector (e.g., "default" or "2025")
selector		= ""

[mailbox]
host			= ""
address			= ""
port			= ""
username		= ""
password		= ""
